# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud


# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
# Leave empty for LiveKit's default user microphone input. Set to "browser"
# only when the backend room-input device is browser and PUBLISH_VOICE=1.
NEXT_PUBLIC_LEXVOICE_DEVICE=
# For browser room input, match the backend agent worker name.
NEXT_PUBLIC_LEXVOICE_AGENT_NAME=
NEXT_PUBLIC_LEXVOICE_BROWSER_VIDEO_WIDTH=1280
NEXT_PUBLIC_LEXVOICE_BROWSER_VIDEO_HEIGHT=720
NEXT_PUBLIC_LEXVOICE_BROWSER_VIDEO_FPS=15
NEXT_PUBLIC_LEXVOICE_BROWSER_VIDEO_MAX_BITRATE=1700000
NEXT_PUBLIC_LEXVOICE_DEBUG_AUDIO=false
NEXT_PUBLIC_LEXVOICE_DEBUG_VIDEO=false
