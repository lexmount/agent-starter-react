# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud


# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
# Leave empty for LiveKit's default user microphone input. Set to "browser"
# only with backend FRONTDESK_DEVICE=browser and PUBLISH_VOICE=1.
NEXT_PUBLIC_FRONTDESK_DEVICE=
# For browser frontdesk, match lex-voice-browser FRONTDESK_AGENT_NAME.
NEXT_PUBLIC_FRONTDESK_AGENT_NAME=
NEXT_PUBLIC_FRONTDESK_BROWSER_VIDEO_WIDTH=1280
NEXT_PUBLIC_FRONTDESK_BROWSER_VIDEO_HEIGHT=720
NEXT_PUBLIC_FRONTDESK_BROWSER_VIDEO_FPS=15
NEXT_PUBLIC_FRONTDESK_BROWSER_VIDEO_MAX_BITRATE=1700000
NEXT_PUBLIC_FRONTDESK_DEBUG_AUDIO=false
NEXT_PUBLIC_FRONTDESK_DEBUG_VIDEO=false
